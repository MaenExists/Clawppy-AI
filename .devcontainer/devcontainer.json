{
  "name": "Clawppy Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "sumneko.vscode-typescript-enabled"
      ]
    }
  },
  "postCreateCommand": "npm install && npm run cf-typegen",
  "remoteUser": "node"
}